<svg viewBox="0 0 800 460" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
  <defs>
    <style>
      .cursor { animation: blink 1.1s steps(1) infinite; }
      @keyframes blink { 0%,49%{opacity:1;} 50%,100%{opacity:0;} }

      .star1{animation: twinkle 2.4s ease-in-out infinite;}
      .star2{animation: twinkle 3.1s ease-in-out infinite .4s;}
      .star3{animation: twinkle 2.7s ease-in-out infinite .9s;}
      .star4{animation: twinkle 3.6s ease-in-out infinite 1.3s;}
      .star5{animation: twinkle 2.9s ease-in-out infinite .7s;}
      @keyframes twinkle {0%,100%{opacity:.25;} 50%{opacity:1;}}

      .steam1{animation: rise 3s ease-in infinite;}
      .steam2{animation: rise 3s ease-in infinite 1s;}
      .steam3{animation: rise 3s ease-in infinite 2s;}
      @keyframes rise {
        0%{transform:translateY(0) scaleX(1); opacity:0;}
        15%{opacity:.8;}
        100%{transform:translateY(-30px) scaleX(1.4); opacity:0;}
      }

      .leaf{transform-origin: 630px 300px; animation: sway 4s ease-in-out infinite;}
      @keyframes sway {0%,100%{transform:rotate(-3deg);} 50%{transform:rotate(3deg);}}

      .light1{animation: glow 1.6s ease-in-out infinite;}
      .light2{animation: glow 1.6s ease-in-out infinite .3s;}
      .light3{animation: glow 1.6s ease-in-out infinite .6s;}
      .light4{animation: glow 1.6s ease-in-out infinite .9s;}
      .light5{animation: glow 1.6s ease-in-out infinite 1.2s;}
      @keyframes glow {0%,100%{opacity:.4;} 50%{opacity:1;}}

      .code-line{animation: type 6s ease-in-out infinite;}
      @keyframes type {
        0%{opacity:0;} 5%{opacity:1;} 90%{opacity:1;} 95%{opacity:0;} 100%{opacity:0;}
      }
    </style>
  </defs>

  <!-- room background -->
  <rect x="0" y="0" width="800" height="460" fill="#0c1626"/>
  <rect x="0" y="0" width="800" height="330" fill="#101d33"/>

  <!-- floor -->
  <rect x="0" y="330" width="800" height="130" fill="#0a1220"/>
  <rect x="0" y="330" width="800" height="6" fill="#3a2c1e"/>

  <!-- window with stars -->
  <g>
    <rect x="590" y="30" width="180" height="140" fill="#1b2c4a" stroke="#2f4568" stroke-width="4"/>
    <rect x="590" y="30" width="180" height="140" fill="none" stroke="#2f4568" stroke-width="4"/>
    <rect x="676" y="30" width="8" height="140" fill="#2f4568"/>
    <rect x="590" y="96" width="180" height="8" fill="#2f4568"/>
    <circle cx="720" cy="70" r="18" fill="#e9edf5" opacity="0.9"/>
    <circle class="star1" cx="615" cy="55" r="2.5" fill="#ffffff"/>
    <circle class="star2" cx="645" cy="130" r="2" fill="#ffffff"/>
    <circle class="star3" cx="700" cy="145" r="2.5" fill="#ffffff"/>
    <circle class="star4" cx="760" cy="60" r="2" fill="#ffffff"/>
    <circle class="star5" cx="630" cy="90" r="2" fill="#ffffff"/>
  </g>

  <!-- string lights across the top -->
  <path d="M40,25 Q400,80 760,25" fill="none" stroke="#39547a" stroke-width="3"/>
  <circle class="light1" cx="120" cy="42" r="6" fill="#ffb454"/>
  <circle class="light2" cx="260" cy="62" r="6" fill="#ff8fa3"/>
  <circle class="light3" cx="400" cy="70" r="6" fill="#6fcf97"/>
  <circle class="light4" cx="540" cy="62" r="6" fill="#4fd1ff"/>
  <circle class="light5" cx="680" cy="42" r="6" fill="#ffb454"/>

  <!-- bookshelf, left wall -->
  <g>
    <rect x="40" y="150" width="150" height="14" fill="#5b3d29"/>
    <rect x="48" y="110" width="12" height="40" fill="#e07a5f"/>
    <rect x="62" y="105" width="12" height="45" fill="#81b29a"/>
    <rect x="76" y="115" width="12" height="35" fill="#f2cc8f"/>
    <rect x="90" y="108" width="12" height="42" fill="#3d5a80"/>
    <rect x="104" y="118" width="12" height="32" fill="#e07a5f"/>
    <rect x="140" y="112" width="40" height="38" fill="#13243b" stroke="#3a5a86" stroke-width="3"/>
    <rect x="150" y="122" width="20" height="14" fill="#4fd1ff" opacity="0.6"/>
  </g>

  <!-- desk -->
  <rect x="230" y="330" width="430" height="16" fill="#5b3d29"/>
  <rect x="230" y="346" width="16" height="70" fill="#3a2818"/>
  <rect x="644" y="346" width="16" height="70" fill="#3a2818"/>

  <!-- monitor -->
  <g>
    <rect x="330" y="230" width="180" height="120" rx="4" fill="#1c2e4a" stroke="#3a5a86" stroke-width="4"/>
    <rect x="342" y="242" width="156" height="96" fill="#0d1b2a"/>
    <text x="352" y="260" font-family="monospace" font-size="11" fill="#6fcf97" class="code-line">const build = () =&gt; {</text>
    <text x="360" y="275" font-family="monospace" font-size="11" fill="#4fd1ff" class="code-line" style="animation-delay:1.5s">ship('feature');</text>
    <text x="360" y="290" font-family="monospace" font-size="11" fill="#ffb454" class="code-line" style="animation-delay:3s">test.pass();</text>
    <text x="352" y="305" font-family="monospace" font-size="11" fill="#6fcf97" class="code-line" style="animation-delay:4.5s">}</text>
    <rect class="cursor" x="360" y="312" width="7" height="12" fill="#e8ecf1"/>
    <rect x="405" y="350" width="30" height="14" fill="#2f4568"/>
    <rect x="385" y="364" width="70" height="8" fill="#3a5a86"/>
  </g>

  <!-- keyboard -->
  <rect x="345" y="378" width="120" height="16" rx="2" fill="#2f4568"/>

  <!-- mug with steam -->
  <g>
    <rect x="500" y="368" width="28" height="24" fill="#e8a0bf"/>
    <rect x="528" y="374" width="8" height="10" fill="none" stroke="#e8a0bf" stroke-width="3"/>
    <rect class="steam1" x="507" y="352" width="4" height="10" fill="#c9d3e0"/>
    <rect class="steam2" x="515" y="352" width="4" height="10" fill="#c9d3e0"/>
    <rect class="steam3" x="511" y="352" width="4" height="10" fill="#c9d3e0"/>
  </g>

  <!-- potted plant -->
  <g class="leaf">
    <rect x="615" y="300" width="30" height="26" fill="#a15c38"/>
    <path d="M630,300 C610,280 600,260 620,250 C625,270 630,285 630,300 Z" fill="#6fcf97"/>
    <path d="M630,300 C650,278 662,258 645,248 C638,268 632,285 630,300 Z" fill="#4f9d74"/>
    <path d="M630,300 C630,270 632,255 638,245 C645,262 640,282 630,300 Z" fill="#81c99a"/>
  </g>

  <!-- character silhouette, seated at desk, typing -->
  <g>
    <!-- chair back -->
    <rect x="255" y="345" width="14" height="60" fill="#22314a"/>
    <!-- body -->
    <path d="M262,345 C250,345 244,365 246,392 L296,392 C298,365 292,345 280,345 Z" fill="#5b4b74"/>
    <!-- head -->
    <circle cx="271" cy="322" r="22" fill="#3a2e40"/>
    <path d="M251,318 C249,300 260,286 271,286 C284,286 293,300 292,318 C285,308 260,308 251,318 Z" fill="#2b2233"/>
    <!-- arm reaching to keyboard -->
    <rect x="292" y="358" width="46" height="10" rx="4" fill="#5b4b74"/>
    <circle cx="340" cy="363" r="6" fill="#caa78d"/>
  </g>

  <!-- floor accent / rug -->
  <rect x="180" y="416" width="440" height="10" fill="#1b2c4a"/>
</svg>
